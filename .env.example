# graph-based-code-analyzer — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=8192

# ── Token FinOps (Rule R1) ────────────────────────────────────────────────────
# Hard ceiling on input tokens per LLM call. Raise only with explicit approval.
TOKEN_BUDGET_INPUT=8000
TOKEN_BUDGET_OUTPUT=4096

# Anthropic pricing (USD per 1M tokens) — update if pricing changes.
COST_PER_M_INPUT_USD=3.00
COST_PER_M_OUTPUT_USD=15.00

# ── Analysis target ───────────────────────────────────────────────────────────
TARGET_REPO_URL=https://github.com/<org>/<repo>
WORKSPACE_DIR=workspace
VAULT_PATH=vault

# ── Parser ────────────────────────────────────────────────────────────────────
SUPPORTED_LANGUAGES=python
MAX_FILE_LOC=150

# ── Checkpointing (Rule R2) ───────────────────────────────────────────────────
CHECKPOINT_DIR=.checkpoints
CHECKPOINT_INTERVAL_NODES=500

# ── Logging ───────────────────────────────────────────────────────────────────
# Choices: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
